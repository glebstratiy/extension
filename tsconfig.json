{
    "compilerOptions": {
      "target": "ES6",
      "lib": ["DOM", "ES6"],
      "jsx": "react",
      "module": "ESNext",
      "moduleResolution": "Node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "dist"
    },
    "include": ["src"]
  }
  